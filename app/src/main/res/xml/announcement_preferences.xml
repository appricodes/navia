<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/announcement_direction_proximity_header"
        app:iconSpaceReserved="false">

        <!-- 1. Announce element in pointing direction -->
        <SwitchPreferenceCompat
            app:key="announcement_poi_direction"
            app:title="@string/announcement_direction_title"
            app:summaryOn="@string/announcement_direction_on"
            app:summaryOff="@string/announcement_direction_off"
            app:defaultValue="true" />

        <!-- 2. Include ways (roads/paths) in the announcement -->
        <SwitchPreferenceCompat
            app:key="announcement_include_ways"
            app:title="@string/announcement_include_ways_title"
            app:summaryOn="@string/announcement_include_ways_on"
            app:summaryOff="@string/announcement_include_ways_off"
            app:dependency="announcement_poi_direction"
            app:defaultValue="false" />

        <!-- 3. Announce nearest points based on location and movement -->
        <SwitchPreferenceCompat
            app:key="announcement_proximity_movement"
            app:title="@string/announcement_movement_title"
            app:summaryOn="@string/announcement_movement_on"
            app:summaryOff="@string/announcement_movement_off"
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/announcement_address_location_header"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="address_format"
            app:title="@string/announcement_address_format_title"
            app:entries="@array/address_format_entries"
            app:entryValues="@array/address_format_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>